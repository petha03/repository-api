### Get Developer Profile - Username too long (over 39 characters)
GET {{baseUrl}}{{apiVersion}}/developers/this-username-is-way-too-long-for-github-validation
Accept: application/json

> {%
    client.test("Returns 400 Bad Request", function() {
        client.assert(response.status === 400, "Response status is not 400");
    });
%}

###

### Get Developer Profile - Empty username
GET {{baseUrl}}{{apiVersion}}/developers/
Accept: application/json

> {%
    client.test("Returns 404 or 400", function() {
        client.assert(response.status === 404 || response.status === 400, "Response status is not 404 or 400");
    });
%}

